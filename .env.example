# ==================== 数据库 ====================
# Docker 模式下无需修改，docker-compose.yml 会自动覆盖
DATABASE_URL="mysql://root:kuiper123@localhost:3306/kuiper"

# ==================== 存储 ====================
# local: 本地文件存储（默认，推荐）
# cos: 腾讯云COS（需要配置下方COS密钥）
# r2: Cloudflare R2（需要配置下方R2密钥，推荐用于需要公开URL的场景）
STORAGE_TYPE=local

# 如果使用 COS 存储，请填写以下配置
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# 如果使用 R2 存储，请填写以下配置
# R2_ACCOUNT_ID=          # Cloudflare Account ID
# R2_ACCESS_KEY_ID=       # R2 API Token Access Key
# R2_SECRET_ACCESS_KEY=   # R2 API Token Secret Key
# R2_BUCKET_NAME=         # R2 Bucket 名称
# R2_PUBLIC_URL=          # R2 公开访问地址（如 https://pub-xxx.r2.dev）

# ==================== R2 备份 bucket（deploy/db-backup.sh 用）====================
# 故意跟主 R2_* 分开 — 主 bucket creds 万一外泄，attacker 不能顺手删备份。
# 在 Cloudflare 建一个独立 bucket（例：kuiperfilm-backups）+ 独立 API token，
# 作用域 (Permissions/Resources) 只限那个 backup bucket。
# 缺这 4 个 var 时 db-backup.sh 仍会跑，但只留本地，不上传 R2。
# R2_BACKUP_BUCKET=             # 例：kuiperfilm-backups
# R2_BACKUP_ACCESS_KEY_ID=      # 备份专用 token（不是主 R2_ACCESS_KEY_ID）
# R2_BACKUP_SECRET_ACCESS_KEY=
# R2_BACKUP_ENDPOINT=           # 例：https://<account-id>.r2.cloudflarestorage.com

# ==================== 认证 ====================
NEXTAUTH_URL=https://localhost
NEXTAUTH_SECRET=please-change-this-to-a-random-string

# ==================== 内部密钥 ====================
CRON_SECRET=please-change-this-cron-secret
INTERNAL_TASK_TOKEN=please-change-this-task-token
API_ENCRYPTION_KEY=please-change-this-encryption-key

# ==================== Redis ====================
# Docker 模式下无需修改，docker-compose.yml 会自动覆盖
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# ==================== Worker 配置 ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# ==================== Bull Board (任务管理面板) ====================
BULL_BOARD_HOST=0.0.0.0
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ==================== 日志 ====================
LOG_UNIFIED_ENABLED=true
LOG_LEVEL=ERROR
LOG_FORMAT=json
LOG_DEBUG_ENABLED=false
LOG_AUDIT_ENABLED=true
LOG_SERVICE=kuiper
LOG_REDACT_KEYS=password,token,apiKey,apikey,authorization,cookie,secret,access_token,refresh_token

# ==================== 计费 ====================
BILLING_MODE=OFF

# ==================== 流式输出 ====================
LLM_STREAM_EPHEMERAL_ENABLED=true
