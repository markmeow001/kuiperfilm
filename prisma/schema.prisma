generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model CharacterAppearance {
  id                   String                  @id @default(uuid())
  characterId          String
  appearanceIndex      Int
  changeReason         String
  description          String?                 @db.Text
  descriptions         String?                 @db.Text
  imageUrl             String?                 @db.Text
  imageUrls            String?                 @db.Text
  selectedIndex        Int?
  // Tencent VOD AIGC pre-registered Element ID (per CreateAigcCustomElement
  // doc §3.9.4.2). When present, the multi-shot worker passes this via
  // ExtInfo.element_list so Kling 3.0-Omni's "固定主体" path activates and
  // identity is bound by Element ID rather than ad-hoc FileInfos reference.
  // Registered lazily on first video gen that needs this appearance.
  tencentVodElementId  String?                 @db.VarChar(64)
  // 2026-05-22 — 火山方舟 asset API pre-registered ID (per CreateAsset
  // doc, see src/lib/ark-asset-api.ts). When status='active', the ARK
  // multi-shot worker passes `asset://<arkAssetId>` in content[].image_url
  // instead of the raw imageUrl, bypassing Seedance 2.0's real-person
  // face filter. arkAssetSourceUrl is a snapshot of imageUrl at register
  // time so we can detect stale assets (user regenerated the appearance)
  // and re-register transparently. Registered async via register-ark-asset
  // worker; status walks pending → processing → active|failed.
  arkAssetId           String?                 @db.VarChar(64)
  arkAssetStatus       String?                 @db.VarChar(16) // pending / processing / active / failed
  arkAssetSourceUrl    String?                 @db.Text
  arkAssetRegisteredAt DateTime?
  arkAssetError        String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @default(now()) @updatedAt
  previousImageUrl     String?                 @db.Text
  previousImageUrls    String?                 @db.Text
  previousDescription  String?                 @db.Text // 上一次的描述词（用于撤回）
  previousDescriptions String?                 @db.Text // 上一次的描述词数组（用于撤回）
  imageMediaId         String?
  imageMedia           MediaObject?            @relation("CharacterAppearanceImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  character            NovelPromotionCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Phase 11.4 — reverse side of EpisodeCharacter.appearanceId so prisma
  // can navigate appearance → episodes-using-it.
  episodeCharacters    EpisodeCharacter[]      @relation("EpisodeCharacterAppearance")

  @@unique([characterId, appearanceIndex])
  @@index([characterId])
  @@index([imageMediaId])
  @@map("character_appearances")
}

model LocationImage {
  id                   String                   @id @default(uuid())
  locationId           String
  imageIndex           Int
  // Approach B-Standard 場景多視角:同一個 location 可有多張圖,
  // imageIndex=0 為主視角(legacy 的單張圖),imageIndex>=1 為額外
  // 視角(如「窗邊」、「正門」、「夜晚」)。viewName 為 nullable
  // string 標籤,worker 端 panel handler 解析 panel description
  // 比對 viewName 命中時改抓對應 imageUrl 當 ref。null 視為主視角。
  viewName             String?                  @db.VarChar(255)
  description          String?                  @db.Text
  imageUrl             String?                  @db.Text
  isSelected           Boolean                  @default(false)
  // Tencent VOD AIGC Element ID — see CharacterAppearance.tencentVodElementId.
  // Registered lazily per image (each view has its own Element).
  tencentVodElementId  String?                  @db.VarChar(64)
  // 2026-05-22 — 火山方舟 asset API — see CharacterAppearance.arkAssetId.
  // Per-view registration (each LocationImage is its own asset).
  arkAssetId           String?                  @db.VarChar(64)
  arkAssetStatus       String?                  @db.VarChar(16)
  arkAssetSourceUrl    String?                  @db.Text
  arkAssetRegisteredAt DateTime?
  arkAssetError        String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  previousImageUrl     String?                  @db.Text
  previousDescription  String?                  @db.Text // 上一次的描述词（用于撤回）
  imageMediaId         String?
  imageMedia           MediaObject?             @relation("LocationImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  location             NovelPromotionLocation   @relation("LocationImages", fields: [locationId], references: [id], onDelete: Cascade)
  selectedByLocations  NovelPromotionLocation[] @relation("SelectedLocationImage")

  @@unique([locationId, imageIndex])
  @@index([locationId])
  @@index([imageMediaId])
  @@map("location_images")
}

model NovelPromotionCharacter {
  id                      String                @id @default(uuid())
  novelPromotionProjectId String
  name                    String
  aliases                 String?               @db.Text
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  customVoiceUrl          String?               @db.Text
  customVoiceMediaId      String?
  customVoiceMedia        MediaObject?          @relation("NovelPromotionCharacterVoiceMedia", fields: [customVoiceMediaId], references: [id], onDelete: SetNull)
  voiceId                 String?
  voiceType               String?
  profileData             String?               @db.Text
  profileConfirmed        Boolean               @default(false)
  introduction            String?               @db.Text // 角色介绍（身份、关系、称呼映射，如"我"对应此角色）
  sourceGlobalCharacterId String? // 🆕 来源全局角色ID（复制时记录）
  appearances             CharacterAppearance[]
  episodeCharacters       EpisodeCharacter[]
  novelPromotionProject   NovelPromotionProject @relation(fields: [novelPromotionProjectId], references: [id], onDelete: Cascade)

  @@index([novelPromotionProjectId])
  @@index([customVoiceMediaId])
  @@map("novel_promotion_characters")
}

model NovelPromotionLocation {
  id                      String                @id @default(uuid())
  novelPromotionProjectId String
  name                    String
  summary                 String?               @db.Text // 场景简要描述（用途/人物关联）
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  sourceGlobalLocationId  String? // 🆕 来源全局场景ID（复制时记录）
  selectedImageId         String?
  selectedImage           LocationImage?        @relation("SelectedLocationImage", fields: [selectedImageId], references: [id], onDelete: SetNull)
  images                  LocationImage[]       @relation("LocationImages")
  episodeLocations        EpisodeLocation[]
  novelPromotionProject   NovelPromotionProject @relation(fields: [novelPromotionProjectId], references: [id], onDelete: Cascade)

  @@index([novelPromotionProjectId])
  @@map("novel_promotion_locations")
}

// Phase 11.2: junction = source of truth for "which characters appear in which episode"
// role distinguishes the origin: 'auto-from-panel' | 'manual' | 'imported-from-global'
model EpisodeCharacter {
  id           String   @id @default(uuid())
  episodeId    String
  characterId  String
  role         String? // 'auto-from-panel' | 'manual' | 'imported-from-global'
  // Phase 11.4 / multi-appearance: which CharacterAppearance row to use
  // when this character shows up in panels of THIS episode. null = fall
  // back to appearance[0] (legacy behaviour). Lets users say "Catherine
  // ep1-10 wears appearance A, ep11+ wears appearance B".
  appearanceId String?
  createdAt    DateTime @default(now())

  episode    NovelPromotionEpisode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  character  NovelPromotionCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  appearance CharacterAppearance?    @relation("EpisodeCharacterAppearance", fields: [appearanceId], references: [id], onDelete: SetNull)

  @@unique([episodeId, characterId])
  @@index([episodeId])
  @@index([characterId])
  @@map("episode_characters")
}

// Phase 11.2: junction = source of truth for "which locations appear in which episode"
model EpisodeLocation {
  id         String   @id @default(uuid())
  episodeId  String
  locationId String
  role       String? // 'auto-from-panel' | 'manual' | 'imported-from-global'
  createdAt  DateTime @default(now())

  episode  NovelPromotionEpisode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  location NovelPromotionLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([episodeId, locationId])
  @@index([episodeId])
  @@index([locationId])
  @@map("episode_locations")
}

model NovelPromotionEpisode {
  id                      String                     @id @default(uuid())
  novelPromotionProjectId String
  episodeNumber           Int
  name                    String
  description             String?                    @db.Text
  novelText               String?                    @db.Text
  audioUrl                String?                    @db.Text
  audioMediaId            String?
  audioMedia              MediaObject?               @relation("NovelPromotionEpisodeAudioMedia", fields: [audioMediaId], references: [id], onDelete: SetNull)
  srtContent              String?                    @db.Text
  // Phase 12.7.x — FFmpeg full-episode stitch output
  stitchedVideoUrl        String?                    @db.Text
  stitchStatus            String? // pending | rendering | completed | failed
  stitchedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @default(now()) @updatedAt
  speakerVoices           String?                    @db.Text
  clips                   NovelPromotionClip[]
  novelPromotionProject   NovelPromotionProject      @relation(fields: [novelPromotionProjectId], references: [id], onDelete: Cascade)
  shots                   NovelPromotionShot[]
  storyboards             NovelPromotionStoryboard[]
  voiceLines              NovelPromotionVoiceLine[]
  editorProject           VideoEditorProject?
  episodeCharacters       EpisodeCharacter[]
  episodeLocations        EpisodeLocation[]

  @@unique([novelPromotionProjectId, episodeNumber])
  @@index([novelPromotionProjectId])
  @@index([audioMediaId])
  @@map("novel_promotion_episodes")
}

// 视频编辑器项目 - 存储剪辑数据
model VideoEditorProject {
  id           String                @id @default(uuid())
  episodeId    String                @unique
  projectData  String                @db.Text // JSON 存储编辑项目数据
  renderStatus String? // pending | rendering | completed | failed
  renderTaskId String?
  outputUrl    String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
  episode      NovelPromotionEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@map("video_editor_projects")
}

model NovelPromotionClip {
  id         String                    @id @default(uuid())
  episodeId  String
  start      Int?
  end        Int?
  duration   Int?
  summary    String                    @db.Text
  location   String?                   @db.Text
  content    String                    @db.Text
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @default(now()) @updatedAt
  characters String?                   @db.Text
  endText    String?                   @db.Text
  shotCount  Int?
  startText  String?                   @db.Text
  screenplay String?                   @db.Text
  episode    NovelPromotionEpisode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  shots      NovelPromotionShot[]
  storyboard NovelPromotionStoryboard?

  @@index([episodeId])
  @@map("novel_promotion_clips")
}

// Phase 1.5A (REDESIGN_PLAN §1.5) — per-panel video generation mode.
// R2V-first 4-mode architecture: worker routing lands in Phase 1.5C;
// until then these fields are dormant (written but not read).
enum PanelGenerationMode {
  direct_t2v          // T2V, no reference — current/legacy behavior
  r2v_with_subjects   // R2V, auto-inject character/location/prop refs (new-panel default from 1.5C)
  t2i_then_i2v        // T2I 4 candidates -> user picks keyframe -> I2V
  r2v_with_motion_ref // R2V + reference camera-motion clip
}

model NovelPromotionPanel {
  id                   String                    @id @default(uuid())
  storyboardId         String
  panelIndex           Int
  panelNumber          Int?
  shotType             String?                   @db.Text
  cameraMove           String?                   @db.Text
  description          String?                   @db.Text
  location             String?                   @db.Text
  characters           String?                   @db.Text
  // Phase 11.3 Stage 2 — props referenced in this panel.
  // JSON-encoded string array of NovelPromotionProp.name values
  // (mirrors `characters` shape, no junction table needed for the
  // simple "what objects appear in this shot" lookup the worker does).
  // Worker reads this in collectPanelReferenceImages() to add prop
  // imageUrl as a generation reference, and in buildSceneDescription()
  // to surface the prop's text description in the prompt.
  // null = no props (legacy panels, current default until LLM extract
  // path lands in Stage 2b).
  props                String?                   @db.Text
  srtSegment           String?                   @db.Text
  srtStart             Float?
  srtEnd               Float?
  duration             Float?
  imagePrompt          String?                   @db.Text
  imageUrl             String?                   @db.Text
  imageMediaId         String?
  imageMedia           MediaObject?              @relation("NovelPromotionPanelImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  imageHistory         String?                   @db.Text
  videoPrompt          String?                   @db.Text
  firstLastFramePrompt String?                   @db.Text
  videoUrl             String?                   @db.Text
  videoGenerationMode  String?                   @db.Text // 视频生成方式：normal | firstlastframe
  videoMediaId         String?
  videoMedia           MediaObject?              @relation("NovelPromotionPanelVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt
  sceneType            String?
  candidateImages      String?                   @db.Text
  linkedToNextPanel    Boolean                   @default(false)
  // Phase 12.5.3 — LLM-assigned multi-shot grouping for Kling batch generation.
  // Panels sharing multiShotGroupId are submitted as one Kling multi_shot=intelligence
  // call; multiShotGroupOrder is the position inside the group (0-indexed).
  // Null means "ungrouped" — falls back to mechanical chunk(5) on the client.
  multiShotGroupId     String?
  multiShotGroupOrder  Int?
  lipSyncTaskId        String?
  lipSyncVideoUrl      String?
  lipSyncVideoMediaId  String?
  lipSyncVideoMedia    MediaObject?              @relation("NovelPromotionPanelLipSyncVideoMedia", fields: [lipSyncVideoMediaId], references: [id], onDelete: SetNull)
  sketchImageUrl       String?                   @db.Text
  sketchImageMediaId   String?
  sketchImageMedia     MediaObject?              @relation("NovelPromotionPanelSketchMedia", fields: [sketchImageMediaId], references: [id], onDelete: SetNull)
  photographyRules     String?                   @db.Text
  actingNotes          String?                   @db.Text // 演技指导数据 JSON
  previousImageUrl     String?                   @db.Text
  previousImageMediaId String?
  previousImageMedia   MediaObject?              @relation("NovelPromotionPanelPreviousImageMedia", fields: [previousImageMediaId], references: [id], onDelete: SetNull)
  // ── Phase 1.5A — R2V-first 4-mode fields (REDESIGN_PLAN §1.5A) ──
  // DB default is direct_t2v (NOT r2v_with_subjects as the spec model
  // block suggests): `prisma db push` applies the default to every
  // existing row, and the spec's own backfill note requires existing
  // panels to stay on current behavior (direct_t2v). The r2v_with_subjects
  // default for NEW panels is applied at the creation sites in Phase 1.5C,
  // where the worker starts reading this field.
  // Named panelGenerationMode (not the spec's generationMode) to avoid
  // colliding with NovelPromotionProject.generationMode (project-level
  // r2v-narrative / t2i-storyboard axis) and the panel's own legacy
  // videoGenerationMode (normal | firstlastframe) in 1.5C worker scopes.
  panelGenerationMode  PanelGenerationMode       @default(direct_t2v)
  sceneContext         String?                   @db.Text // locked T2I/T2V prompt derived from description
  motionLine           String?                   @db.Text // I2V motion description (LLM-derived or user-edited)
  keyframeUrl          String?                   @db.Text // T2I->I2V: the selected keyframe (system-generated; imageUrl stays user-uploaded reference)
  // JSON-encoded string array — mirrors candidateImages/characters/props
  // convention on this model (panels have no native Json columns).
  keyframeCandidates   String?                   @db.Text // T2I->I2V: 4 candidate thumbs (originals live in object storage)
  r2vMotionRefUrl      String?                   @db.Text // R2V+motion: reference camera-motion clip
  perShotProvider      String?                   @db.VarChar(128) // per-shot model override, e.g. "ark::seedance-2.0-r2v"
  storyboard           NovelPromotionStoryboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  matchedVoiceLines    NovelPromotionVoiceLine[]

  @@unique([storyboardId, panelIndex])
  @@index([storyboardId])
  @@index([imageMediaId])
  @@index([videoMediaId])
  @@index([lipSyncVideoMediaId])
  @@index([sketchImageMediaId])
  @@index([previousImageMediaId])
  @@map("novel_promotion_panels")
}

model NovelPromotionProject {
  id                   String                    @id @default(uuid())
  projectId            String                    @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt
  analysisModel        String? // 用户配置的分析模型（nullable，必须配置后才能使用）
  imageModel           String? // 用户配置的图片模型
  videoModel           String? // 用户配置的视频模型
  videoRatio           String                    @default("9:16")
  targetDuration       Int                       @default(60) // 目标视频时长（秒）
  // 2026-05-29 — per-project 生成模式。
  //   r2v-narrative  = text→AI切組→Seedance R2V，無 T2I（新專案經建立 API 預設此值）
  //   t2i-storyboard = 文生圖分鏡→圖生視頻（legacy）
  // 欄位 @default 故意設 legacy：prod 走 prisma db push，新增此欄時既有 row 會
  // 套欄位 default，設成 t2i 才能保留既有用戶現狀；新專案由建立 API 顯式帶
  // r2v-narrative。read 端的 resolveGenerationModeBehavior(null) 另以 r2v 為安全預設。
  generationMode       String                    @default("t2i-storyboard")
  // 開場節奏：hook=短劇冷開場快節奏（現狀預設）；cinematic=電影氛圍開場（開場獨立成組慢鋪）
  openingPacing        String                    @default("hook")
  ttsRate              String                    @default("+50%")
  globalAssetText      String?                   @db.Text
  // deprecated: replaced by styleProfile fields (stylePositivePrompt / styleNegativePrompt / styleReferenceImages),
  // kept for migration trace only. Do not write from new code.
  artStyle             String                    @default("american-comic")
  // deprecated: replaced by styleProfile fields, kept for migration trace, do not write
  artStylePrompt       String?                   @db.Text
  stylePositivePrompt  String?                   @db.Text
  styleNegativePrompt  String?                   @db.Text
  styleReferenceImages String?                   @db.Text // JSON array of MediaObject ids
  // Phase 11.5+ preset tracking: which preset card the user clicked.
  // Lets the picker UI highlight the active preset across reloads
  // without having to fuzzy-match on the prompt text.
  stylePresetKey       String?
  // Phase C (2026-05-13) — curated VisualStyle library selection.
  // Layers TEXT-based style anchor on top of existing styleProfile
  // image-based pipeline. Both can coexist: styleProfile pins visual
  // identity via Tencent CustomElement; visualStyleId injects the
  // 30-style curated text anchor + lighting preset.
  // Phase J (2026-05-21) — default 'cinematic_realism' for new rows.
  // Mirrors DEFAULT_PROJECT_VISUAL_STYLE_ID in lib/style-library/loader.ts;
  // both must stay in sync. NULL is still legal on existing rows (and
  // resolveProjectVisualStyle falls back to the same constant), so
  // we do NOT need a backfill migration — only newly inserted projects
  // will land with this default.
  visualStyleId        String?                   @default("cinematic_realism")
  lightingPresetId     String?
  characterModel       String? // 用户配置的角色图片模型
  locationModel        String? // 用户配置的场景图片模型
  storyboardModel      String? // 用户配置的分镜图片模型
  editModel            String? // 用户配置的修图/编辑模型
  videoResolution      String                    @default("720p")
  capabilityOverrides  String?                   @db.Text
  workflowMode         String                    @default("srt")
  lastEpisodeId        String?
  imageResolution      String                    @default("2K")
  importStatus         String?
  characters           NovelPromotionCharacter[]
  episodes             NovelPromotionEpisode[]
  locations            NovelPromotionLocation[]
  // Phase 11.3 — props as first-class assets
  props                NovelPromotionProp[]
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("novel_promotion_projects")
}

// Sticky-step navigation (2026-05-11)
//
// Remembers which V2 workspace step each user was last on, per project.
// On F5 / re-entering a project, the home page redirects to lastStep.
// Deep-link `?startAt=<step>` overrides AND records the new step.
//
// Per-user, per-project — different editors viewing the same project
// keep their own cursor (writer on script, director on storyboard, etc.)
model UserProjectState {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  // 'home' | 'script' | 'subjects' | 'storyboard' | 'voice' | 'final'
  lastStep  String
  updatedAt DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_project_state")
}

model NovelPromotionShot {
  id           String                @id @default(uuid())
  episodeId    String
  clipId       String?
  shotId       String
  srtStart     Int
  srtEnd       Int
  srtDuration  Float
  sequence     String?               @db.Text
  locations    String?               @db.Text
  characters   String?               @db.Text
  plot         String?               @db.Text
  imagePrompt  String?               @db.Text
  scale        String?               @db.Text
  module       String?               @db.Text
  focus        String?               @db.Text
  zhSummarize  String?               @db.Text
  imageUrl     String?               @db.Text
  imageMediaId String?
  imageMedia   MediaObject?          @relation("NovelPromotionShotImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
  pov          String?               @db.Text
  clip         NovelPromotionClip?   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  episode      NovelPromotionEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([clipId])
  @@index([episodeId])
  @@index([shotId])
  @@index([imageMediaId])
  @@map("novel_promotion_shots")
}

model NovelPromotionStoryboard {
  id                  String                @id @default(uuid())
  episodeId           String
  clipId              String                @unique
  storyboardImageUrl  String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  panelCount          Int                   @default(9)
  storyboardTextJson  String?               @db.Text
  imageHistory        String?               @db.Text
  candidateImages     String?               @db.Text
  lastError           String?
  photographyPlan     String?               @db.Text
  multiShotVideoUrl   String?               @db.Text
  // 2026-05-03 — when a panel group's dialogue exceeds Kling Omni's
  // 15s per-call cap, the worker splits into N chunks and stores
  // each chunk's mp4 URL in this JSON array. Reader prefers this when
  // set; falls back to wrapping multiShotVideoUrl in a single-element
  // array for legacy storyboards.
  multiShotClipUrls   String?               @db.Text
  // Phase S (2026-05-27) — per-group motion / camera reference video.
  // User uploads a short clip (≤15s, ≤50MB, mp4/mov/webm) and the
  // worker passes it to the R2V endpoint of whichever Seedance vendor
  // is selected: fal.video_urls[], atlascloud.reference_videos[],
  // BobAPI content[]:video_url, ARK content[]:video_url. NULL = no
  // motion ref (default; image-only flow). Stored as COS key, signed
  // via toSignedUrlIfCos at worker time. Single field because all four
  // vendors converge on "1 reference video per generation".
  referenceVideoUrl   String?               @db.Text
  panels              NovelPromotionPanel[]
  clip                NovelPromotionClip    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  episode             NovelPromotionEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  supplementaryPanels SupplementaryPanel[]

  @@index([clipId])
  @@index([episodeId])
  @@map("novel_promotion_storyboards")
}

model SupplementaryPanel {
  id            String                   @id @default(uuid())
  storyboardId  String
  sourceType    String
  sourcePanelId String?
  description   String?                  @db.Text
  imagePrompt   String?                  @db.Text
  imageUrl      String?                  @db.Text
  imageMediaId  String?
  imageMedia    MediaObject?             @relation("SupplementaryPanelImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  characters    String?                  @db.Text
  location      String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  storyboard    NovelPromotionStoryboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@index([storyboardId])
  @@index([imageMediaId])
  @@map("supplementary_panels")
}

model Project {
  id                 String                 @id @default(uuid())
  name               String
  description        String?                @db.Text
  mode               String                 @default("novel-promotion")
  userId             String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  lastAccessedAt     DateTime?
  // Phase 12.5 (2026-05-22) — workspace assignment.
  // NULL = personal (legacy + standalone). Set to bind project to a
  // workspace so all workspace members get default access per their
  // WorkspaceMember.role (editor RW / viewer read-only).
  workspaceId        String?
  // Phase 12.5 (2026-05-22) — soft delete with 30-day grace period.
  // DELETE endpoint sets deletedAt; a daily cron hard-deletes rows
  // where deletedAt is older than 30 days. Owner can restore via
  // POST /api/projects/:id/restore within the grace window.
  deletedAt          DateTime?
  deletedBy          String?
  // Phase 2.5 (2026-06-10) — Skill primitive. NULL = generic 自由創作.
  // Set = project was created via a Skill picker selection; workers
  // read the Skill's config to drive pipeline + defaults + prompts.
  // SetNull on delete so retiring a Skill doesn't orphan its projects.
  originSkillId      String?
  originSkill        Skill?                 @relation("SkillOriginatedProjects", fields: [originSkillId], references: [id], onDelete: SetNull)
  novelPromotionData NovelPromotionProject?
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace?             @relation("WorkspaceProjects", fields: [workspaceId], references: [id], onDelete: SetNull)
  deleter            User?                  @relation("ProjectDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  usageCosts         UsageCost[]
  // Sticky-step navigation: per-user last step on this project
  userProjectStates  UserProjectState[]
  // Phase 12.5 — Figma-style per-project explicit grants (overrides workspace default)
  collaborators      ProjectCollaborator[]
  editRequests       EditRequest[]

  @@index([userId])
  @@index([workspaceId])
  @@index([deletedAt])
  @@index([originSkillId])
  @@map("projects")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model UsageCost {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  apiType   String
  model     String
  action    String
  quantity  Int
  unit      String
  cost      Decimal  @db.Decimal(18, 6)
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiType])
  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
  @@map("usage_costs")
}

model User {
  id            String          @id @default(uuid())
  name          String          @unique(map: "User_name_key")
  email         String?
  emailVerified DateTime?
  image         String?
  password      String?
  role          String          @default("member") // admin | editor | member
  displayName   String?
  isActive      Boolean         @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  accounts      Account[]
  projects      Project[]
  sessions      Session[]
  usageCosts    UsageCost[]
  balance       UserBalance?
  preferences   UserPreference?

  // 资产中心
  globalAssetFolders GlobalAssetFolder[]
  globalCharacters   GlobalCharacter[]
  globalLocations    GlobalLocation[]
  globalVoices       GlobalVoice[]
  // Phase 11.3 — props as first-class assets (knife / letter / ring etc).
  globalProps        GlobalProp[]        @relation("UserGlobalProps")
  tasks              Task[]
  taskEvents         TaskEvent[]
  graphRuns          GraphRun[]
  graphEvents        GraphEvent[]

  // 多人系统：邀请码（建立 / 使用关系）
  invitesCreated InviteCode[] @relation("InviteCreator")
  inviteUsed     InviteCode[] @relation("InviteUsedBy")

  // Q-005: MediaObject ownership reverse relation
  uploadedMedia MediaObject[] @relation("MediaObjectUploader")

  // Multi-tenant org → workspace → member hierarchy (2026-05-02)
  // - ownedOrganizations: Organization records I created (admin/editor)
  // - ownedWorkspaces: Workspaces I manage as the editor
  // - workspaceMemberships: Workspaces I'm a member of (M:N)
  // - workspaceMembersAdded: WorkspaceMember rows I added (audit trail)
  ownedOrganizations    Organization[]    @relation("OrganizationOwner")
  ownedWorkspaces       Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[] @relation("WorkspaceMembership")
  workspaceMembersAdded WorkspaceMember[] @relation("WorkspaceMemberAddedBy")
  // Phase 5 (2026-05-25) — public API keys this user created. Soft-deleted
  // keys (revokedAt) still reference back here so audit trails work even
  // after the creator account is disabled.
  apiKeysCreated        ApiKey[]          @relation("ApiKeyCreatedBy")

  // Sticky-step navigation: remembers per-user last step on each project
  userProjectStates UserProjectState[]

  // Phase 12.5 (2026-05-22) — Figma-style collaboration
  projectCollaborations        ProjectCollaborator[] @relation("CollaboratorUser")
  projectCollaborationsGranted ProjectCollaborator[] @relation("CollaboratorGrantedBy")
  editRequestsMade             EditRequest[]         @relation("EditRequester")
  editRequestsResolved         EditRequest[]         @relation("EditRequestResolver")
  auditLogActions              AuditLog[]            @relation("AuditActor")
  deletedProjects              Project[]             @relation("ProjectDeletedBy")

  // Phase T (2026-05-27) — Playground / Freedom Mode runs owned by this user.
  playgroundRuns PlaygroundRun[] @relation("PlaygroundRunUser")

  // 2026-06-27 — 无限画布 rows owned by this user.
  canvases Canvas[] @relation("CanvasUser")

  // Phase 2.5 (2026-06-10) — Skill primitive. Community-authored Skills
  // owned by this user + per-user installed Skill records (我的 Skill).
  // See IMPL_PREP/R-skill-primitive.md for the full spec.
  authoredSkills      Skill[]             @relation("SkillAuthor")
  skillInstallations  SkillInstallation[]

  @@map("user")
}

// ──────────── Multi-tenant hierarchy (2026-05-02) ────────────
//
// Org → Workspace → Member three-tier model:
//
//   - Organization is the top-level container. Admin (or any user with
//     editor permission to create one) provisions an org, optionally
//     groups multiple workspaces under it.
//   - Workspace is the working unit a single editor manages. Editors
//     can own ANY number of workspaces (1:N). Each workspace has its
//     own member list.
//   - WorkspaceMember is the M:N join — one user can be in many
//     workspaces (e.g. the same writer assigned to multiple editors'
//     teams). Editors decide who joins; members can't self-leave.
//
// Auth contract: an editor sees + edits any project owned by a user
// in any workspace they own. Admin still has implicit cross-user
// access (multi-user demo override).

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner      User        @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  workspaces Workspace[]

  @@index([ownerUserId])
  @@map("organization")
}

model Workspace {
  id             String   @id @default(uuid())
  name           String
  description    String?  @db.Text
  organizationId String
  ownerEditorId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User              @relation("WorkspaceOwner", fields: [ownerEditorId], references: [id], onDelete: Restrict)
  members        WorkspaceMember[]
  // Phase 12.5 — projects bound to this workspace (NULL projects = personal/legacy)
  projects       Project[]         @relation("WorkspaceProjects")
  // Phase 5 (2026-05-25) — workspace-scoped API keys for public API access.
  apiKeys        ApiKey[]
  // Phase T (2026-05-27) — Playground freedom-mode runs (independent of projects).
  playgroundRuns PlaygroundRun[]

  @@index([organizationId])
  @@index([ownerEditorId])
  @@map("workspace")
}

// Phase T (2026-05-27) — Playground / Freedom Mode runs.
// Independent of NovelPromotionProject — users come here to generate a single
// image or video from a prompt + references without setting up a full storyboard
// project. Each run is one image OR one video generation. Reuses the existing
// 4-vendor video dispatcher (fal / atlascloud / bobapi / ark) and existing image
// generators (Tencent / OpenAI / Gemini / Replicate) — no new generator code.
//
// Workspace-scoped (optional). When workspaceId is set, all workspace members
// can see the run in shared history; when null, it's a personal run only the
// userId owner can see.
//
// Reference uploads: COS keys stored as JSON arrays. Same single-video cap as
// the per-group ref video (Phase S) — vendor parity with ARK's singular
// referenceVideoUrl. See feedback_kuiperfilm_ref_video_lowest_common_denominator.
model PlaygroundRun {
  id              String    @id @default(uuid())
  userId          String
  workspaceId     String?
  // User-typed prompt with @imageN / @videoN tokens. Worker resolves @-tokens
  // against referenceImages / referenceVideos arrays by 1-indexed position.
  prompt          String    @db.Text
  // JSON array of COS keys (strings). max 9 per Phase T-1 cap; mirrors picker grid.
  referenceImages String?   @db.Text
  // JSON array — max 1 today per Phase S decision (ARK lowest common denominator).
  referenceVideos String?   @db.Text
  // Optional free-form style / tone hint.
  referenceText   String?   @db.Text
  // 'image' | 'video' — drives which generator the worker dispatches to.
  outputType      String
  // Canonical 'provider::modelId' (e.g. 'fal::bytedance/seedance-2.0/reference-to-video',
  // 'atlascloud::imagen-3', etc).
  modelKey        String
  // Optional generation params; null = generator default.
  resolution      String?
  durationSec     Int?
  aspectRatio     String?
  // Number of variants to generate per run (Phase T-1 caps at 1).
  generationCount Int       @default(1)
  // 'pending' | 'running' | 'succeeded' | 'failed'
  status          String    @default("pending")
  // JSON array of result COS keys when succeeded.
  resultUrls      String?   @db.Text
  // Task / external job id for poll-and-retrieve flows.
  externalTaskId  String?
  costEstimate    Float?
  costActual      Float?
  // 2026-06-12 PR-A2 — Playground 接 billing freeze/capture/refund 三段。
  // freezeId: BalanceFreeze.id written at submit; null = no freeze (mode=OFF
  // or quotedCost=0). Worker uses this to confirm/rollback on terminal state.
  // pricingVersion: snapshot of catalog version at submit, defensive against
  // mid-run catalog rewrites. Phase 9.1 will replace this whole sidecar with
  // proper Task-bound billing via prepareTaskBilling/settleTaskBilling.
  freezeId        String?
  pricingVersion  String?
  errorMessage    String?   @db.Text
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  user      User       @relation("PlaygroundRunUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([freezeId])
  @@map("playground_runs")
}

// 2026-06-27 — 无限画布（Infinite Canvas）. Independent creative surface like
// Playground (not tied to a NovelPromotion project). One row per canvas;
// nodes/edges/viewport are JSON-serialized blobs (React Flow shape). Stored as
// @db.Text JSON strings to mirror PlaygroundRun's MySQL-friendly convention.
// workspaceId is a plain scalar (no FK — same as Task.projectId) so we don't
// have to thread a reverse relation through Workspace.
model Canvas {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  title       String   @default("未命名画布")
  // JSON.stringify(SerializedNode[]) — see app/[locale]/canvas/lib/canvas-types.
  // MediumText (16MB): a canvas with stage blobs/keys can exceed Text's 64KB,
  // which would truncate → corrupt JSON → silent canvas wipe.
  nodes       String   @db.MediumText
  // JSON.stringify(SerializedEdge[]).
  edges       String   @db.MediumText
  // JSON.stringify(SerializedViewport) — nullable until first save.
  viewport    String?  @db.MediumText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("CanvasUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("canvas")
}

// Phase 5 (2026-05-25) — Public API key for external automation (AI agents,
// CLI, MCP, third-party integrations). Workspace-scoped per the design doc
// — keys belong to a workspace, not a user. Workspace owner + admin can
// create / revoke; members can view but not mutate. Mirrors GitHub PAT /
// Stripe API key UX: full key shown ONCE at creation, after that only
// keyPrefix + last 4 chars are queryable. Hash-based storage means a leak
// from DB alone cannot recover the original token.
//
// Scope-based authorization (read / scripts.write / etc.) is enforced
// per-endpoint via the public API middleware. revokedAt is a soft-delete
// so historical usage logs stay readable for audit.
model ApiKey {
  id            String    @id @default(uuid())
  workspaceId   String
  name          String    @db.VarChar(64)
  // First 12 chars of the key: `kfk_<8-char-random>`. Indexed so the
  // middleware can look up the row in O(1) before doing the hash compare.
  // Stored in plaintext because it's not a secret (it's used as a public
  // identifier in dev console + logs + error messages).
  keyPrefix     String    @unique @db.VarChar(16)
  // SHA-256 hex of the full key (kfk_<prefix>_<secret>). 64 chars.
  // Compared with timingSafeEqual at auth time.
  keyHash       String    @db.VarChar(64)
  // Last 4 chars of the full key, surfaced in UI as `kfk_xxxxxxxx…abcd`
  // so the user can recognize which key is which without revealing the
  // full token. Not a secret.
  keyLast4      String    @db.VarChar(4)
  // JSON array of scope strings. Validated against PUBLIC_API_SCOPES enum
  // at create time; trusted at runtime (no re-validation per request).
  // Example: ["read","scripts.write","videos.write"]
  scopes        String    @db.Text
  // Per-key sliding-window rate limit. Default 60 (matches PolyFilm).
  // Enforced via Redis ZADD/ZCOUNT per `apiRate:{keyId}` key.
  reqPerMinute  Int       @default(60)
  // Optional cap on monthly call count (across all endpoints). null =
  // unlimited. Checked against ApiKeyUsage.createdAt aggregation; if hit,
  // 429 with code RATE_LIMIT_MONTHLY.
  monthlyCredit Int?
  expiresAt     DateTime?
  // Updated lazily on each successful auth — eventual-consistent within
  // ~60s (we don't write on every call, only on rate-limit window flush).
  lastUsedAt    DateTime?
  createdById   String
  // Soft delete. Once set, the key fails auth with REVOKED but
  // ApiKeyUsage rows remain queryable for audit.
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usages    ApiKeyUsage[]

  @@index([workspaceId])
  @@index([keyPrefix])
  @@index([createdById])
  @@map("api_keys")
}

// Phase 5 (2026-05-25) — per-call audit log. Written async (best-effort,
// fire-and-forget) so a slow DB doesn't block the API response. Used by
// dev console usage chart + monthly credit enforcement.
model ApiKeyUsage {
  id         String   @id @default(uuid())
  apiKeyId   String
  // Canonical endpoint path: `/v1/projects`, `/v1/episodes/:id:produce`.
  // Param placeholders (`:id`) instead of concrete values so the usage
  // dashboard groups requests by endpoint kind, not individual resource.
  endpoint   String   @db.VarChar(128)
  method     String   @db.VarChar(8)
  statusCode Int
  durationMs Int
  ipAddress  String?  @db.VarChar(45) // IPv6 max 39 + safety
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@map("api_key_usages")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  addedBy     String
  joinedAt    DateTime      @default(now())
  // Phase 12.5 (2026-05-22) — workspace-scoped role.
  // Default 'viewer' for NEW members; existing rows backfill to 'editor'
  // to preserve current 4-tier cascade behavior (existing members had
  // implicit RW via editorCanAccessProject + workspace owner ed access).
  // See docs/plans/workspace-collaboration-spec.md §3.4.
  role        WorkspaceRole @default(viewer)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMembership", fields: [userId], references: [id], onDelete: Cascade)
  adder     User      @relation("WorkspaceMemberAddedBy", fields: [addedBy], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([addedBy])
  @@map("workspace_member")
}

enum WorkspaceRole {
  editor // Default workspace-wide RW on member projects
  viewer // Default workspace-wide read-only on member projects
}

// ──────────── Phase 12.5 Figma-style collaboration (2026-05-22) ────────────
//
// Three new tables layered on top of the existing Org → Workspace → Member
// hierarchy to support per-project access grants and request-to-edit flow:
//
//   ProjectCollaborator — per-project explicit role override (Figma "share")
//   EditRequest         — viewer asks owner for edit access (Figma "request")
//   AuditLog            — accountability trail for destructive / privileged actions
//
// Auth cascade (full 8 steps, see docs/plans/workspace-collaboration-spec.md §4):
//   1 owner | 2 admin | 3 workspace.ownerEditor (via P.workspaceId)
//   3.5 LEGACY editorCanAccessProject (kept for projects with workspaceId=NULL)
//   4 ProjectCollaborator (overrides #5) | 5 WorkspaceMember.role | 6 403
// ────────────────────────────────────────────────────────────────────────────

model ProjectCollaborator {
  projectId String
  userId    String
  // Per-project role, overrides WorkspaceMember.role for this project only
  role      ProjectCollabRole
  grantedBy String
  grantedAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  granter User    @relation("CollaboratorGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@index([grantedBy])
  @@map("project_collaborator")
}

enum ProjectCollabRole {
  editor
  viewer
}

model EditRequest {
  id          String        @id @default(uuid())
  projectId   String
  requesterId String
  status      RequestStatus @default(pending)
  message     String?       @db.Text
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User    @relation("EditRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resolver  User?   @relation("EditRequestResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([requesterId])
  @@index([status, createdAt]) // for cron auto-expire scan
  @@map("edit_request")
}

enum RequestStatus {
  pending
  approved
  denied
  expired // Auto-set after 7 days
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String // Actor
  projectId  String? // Affected project (nullable for workspace-level actions)
  action     String // e.g. "panel.update" / "project.delete" / "collaborator.add"
  entityType String // "Panel" | "Project" | "Character" | "Collaborator" | etc.
  entityId   String
  snapshot   Json? // Pre-mutation state (destructive actions only)
  createdAt  DateTime @default(now())

  user User @relation("AuditActor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("audit_log")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  analysisModel      String? // 用户配置的分析模型（nullable，必须配置后才能使用）
  characterModel     String? // 用户配置的角色图片模型
  locationModel      String? // 用户配置的场景图片模型
  storyboardModel    String? // 用户配置的分镜图片模型
  editModel          String? // 用户配置的修图模型
  videoModel         String? // 用户配置的视频模型
  lipSyncModel       String? // 用户配置的口型同步模型
  videoRatio         String   @default("9:16")
  videoResolution    String   @default("720p")
  artStyle           String   @default("american-comic")
  ttsRate            String   @default("+50%")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  imageResolution    String   @default("2K")
  capabilityDefaults String?  @db.Text

  // API Key 配置（极简版）
  llmBaseUrl  String? @default("https://openrouter.ai/api/v1")
  llmApiKey   String? @db.Text // 加密存储
  falApiKey   String? @db.Text // FAL（图片+视频+语音）
  googleAiKey String? @db.Text // Google AI（Gemini 图片）
  arkApiKey   String? @db.Text // 火山引擎（Seedream+Seedance）
  qwenApiKey  String? @db.Text // 阿里百炼（声音设计）

  // 自定义模型列表 + 价格（JSON）
  customModels String? @db.Text

  // 自定义 OpenAI 兼容提供商列表（JSON，包含加密的 API Key）
  customProviders String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model NovelPromotionVoiceLine {
  id                  String                @id @default(uuid())
  episodeId           String
  lineIndex           Int
  speaker             String
  content             String                @db.Text
  voicePresetId       String?
  audioUrl            String?               @db.Text
  audioMediaId        String?
  audioMedia          MediaObject?          @relation("NovelPromotionVoiceLineAudioMedia", fields: [audioMediaId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  emotionPrompt       String?               @db.Text
  emotionStrength     Float?                @default(0.4)
  matchedPanelIndex   Int?
  matchedStoryboardId String?
  audioDuration       Int?
  matchedPanelId      String?
  episode             NovelPromotionEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  matchedPanel        NovelPromotionPanel?  @relation(fields: [matchedPanelId], references: [id])

  @@unique([episodeId, lineIndex])
  @@index([episodeId])
  @@index([matchedPanelId])
  @@index([audioMediaId])
  @@map("novel_promotion_voice_lines")
}

model VoicePreset {
  id           String       @id @default(uuid())
  name         String
  audioUrl     String       @db.Text
  audioMediaId String?
  audioMedia   MediaObject? @relation("VoicePresetAudioMedia", fields: [audioMediaId], references: [id], onDelete: SetNull)
  description  String?      @db.Text
  gender       String?
  isSystem     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([audioMediaId])
  @@map("voice_presets")
}

model UserBalance {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 6)
  frozenAmount Decimal  @default(0) @db.Decimal(18, 6)
  totalSpent   Decimal  @default(0) @db.Decimal(18, 6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_balances")
}

model BalanceFreeze {
