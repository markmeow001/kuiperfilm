  @@unique([runId, stepKey, attempt])
  @@index([runId, stepKey])
  @@index([runId, createdAt])
  @@map("graph_step_attempts")
}

model GraphEvent {
  id        BigInt   @id @default(autoincrement())
  runId     String
  projectId String
  userId    String
  seq       Int
  eventType String
