model LegacyMediaRefBackup {
  id          String   @id @default(uuid())
  runId       String
  tableName   String
  rowId       String
  fieldName   String
  legacyValue String   @db.Text
  checksum    String
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([tableName, fieldName])
  @@map("legacy_media_refs_backup")
}

// 多人系统：邀请码
//
// 注册采用「凭码注册」模式：管理员先 POST /api/admin/invites 生成一段
// uppercase hex code 给受邀人，受邀人在 /auth/signup 输入这串码即可加入团队。
// 每张码只能用一次（usedBy 记录使用者），可设过期或撤销。
model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique // 例如 3042FDE10070A322257C1711
  role      String    @default("member") // admin | editor | member
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  note      String?   @db.VarChar(200)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  creator User  @relation("InviteCreator", fields: [createdBy], references: [id])
  user    User? @relation("InviteUsedBy", fields: [usedBy], references: [id])

  @@index([createdBy])
  @@index([usedBy])
  @@map("invite_codes")
}

// ============================================================
// Style Library (2026-05-13) — design doc: docs/style-library-design-v3.md
//
// 29 visual styles × 8 lighting presets, replacing the legacy 22-entry
// in-memory STYLE_PROFILE_PRESETS catalog with a DB-backed source of
// truth that the admin UI can edit without code deploy.
//
// Two recommendation/element tables from the original SQL schema are
// intentionally NOT included here — they're for future genre-based
// recommendation surfacing and Kling SubjectInfos pre-registration that
// the platform doesn't ship yet. Add them when those features ship.
//
// MySQL note: PostgreSQL JSONB → MySQL `Json` (Prisma uses MySQL's
// native JSON column under the hood, same query semantics).
// ============================================================
model VisualStyle {
  id                      String   @id @db.VarChar(64)
  nameZh                  String   @db.VarChar(64)
  nameEn                  String   @db.VarChar(64)
  /// A/B/C/D/E/F/G — see docs/style-library-design-v3.md category map.
  category                String   @db.VarChar(32)
  categoryNameZh          String   @db.VarChar(32)
  /// Reference / thumbnail URL for UI cards. Generated via the Step 4 runbook.
  thumbnailUrl            String?  @db.Text
  /// English style anchor — prepended to Kling prompt (highest attention weight).
  styleAnchor             String   @db.Text
  /// Visual modifiers — appended to prompt body (Style Bible reinforcement).
  visualModifiers         String   @db.Text
  /// Full negative prompt (overrides preset defaults).
  negativePrompt          String   @db.Text
  /// JSON string[] — reference artists/works for UI + future SubjectInfos hints.
  referenceArtists        Json?
  /// JSON string[] — genres this style fits best (UI recommendation).
  bestForGenres           Json?
  /// '3.0' | '3.0-Omni' — picks the VOD ModelVersion / VCLM model name.
  recommendedKlingVersion String   @default("3.0-Omni") @db.VarChar(16)
  /// JSON string[] — searchable tags.
  tags                    Json?
  displayOrder            Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  @@index([category, displayOrder])
  @@index([isActive])
  @@map("visual_styles")
}

model LightingPreset {
  id                 String   @id @db.VarChar(64)
  nameZh             String   @db.VarChar(64)
  nameEn             String   @db.VarChar(64)
  thumbnailUrl       String?  @db.Text
  /// Lighting clause inserted between userContent and visualModifiers.
  lightingOverride   String   @db.Text
  /// Lighting-specific negatives, appended to style.negativePrompt at prompt-build time.
  additionalNegative String?  @db.Text
  /// JSON string[] — mood tags for UI recommendation.
  bestForMoods       Json?
  /// JSON string[].
  tags               Json?
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([displayOrder])
  @@index([isActive])
  @@map("lighting_presets")
}

// ──────────── Phase 2.5 (2026-06-10) — Skill primitive ────────────
//
// Skill = (workflow + model chain + prompt template + workflow
// constraints) named, attributable, shareable bundle. Mirror of flova's
// 我的 Skill (official) + 精選 Skill (community) two-tier marketplace.
//
// See IMPL_PREP/R-skill-primitive.md for full spec including:
//   §4: schema rationale
//   §5: SkillConfig JSON shape
//   §6: 6 official Skills mapping existing KuiperAI workers
//   §7: UI surfaces (picker chip, library page, marketplace)
//   §8: permissions reuse the 8-tier project access cascade
//
// Workspace-scoped Skills (workspaceId set) are internal-only to that
// workspace; global Skills (workspaceId null) are visible to everyone.

enum SkillAuthorType {
  official  // 我的 Skill default set, attribution = @Flova / @KuiperAI
  community // 精選 + user-created, attribution = creator username
}

enum SkillStatus {
  draft     // author still editing
  published // visible in marketplace + installable
  archived  // hidden but existing installations keep working
}

model Skill {
  id           String @id @default(uuid())
  /// url-safe — e.g. "drama-short-seedance-voice".
  slug         String @unique @db.VarChar(128)
  /// Display name, primary language. e.g. "劇情短片視頻".
  name         String @db.VarChar(128)
  /// Optional bilingual name for the EN locale.
  nameEn       String? @db.VarChar(128)
  /// Multi-paragraph spec — what the Skill does, what pipeline it runs,
  /// what user must supply. Markdown allowed.
  description     String  @db.Text
  descriptionEn   String? @db.Text
  /// Hero image. Optional. Auto-rendered preview placeholder when null.
  thumbnailUrl    String? @db.Text

  // ── Attribution ─────────────────────────────────────────
  authorType    SkillAuthorType
  /// Null for official Skills. Set for community-authored.
  authorUserId  String?
  /// Display name shown in UI. e.g. "@Flova" or "@阿娴".
  authorDisplay String          @db.VarChar(64)
  author        User?           @relation("SkillAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  // ── Marketplace state ──────────────────────────────────
  status          SkillStatus @default(draft)
  /// 精選 ribbon — official Skills are featured by default; community
  /// Skills get featured via admin review.
  isFeatured      Boolean     @default(false)
  /// For 熱門 sorting. Updated periodically via batch job — not on
  /// every install/run to avoid hot-row contention.
  popularityScore Int         @default(0)
  /// How many users currently have this Skill installed (enabled or not).
  installCount    Int         @default(0)

  // ── Runtime config ──────────────────────────────────────
  /// JSON shape — see IMPL_PREP/R-skill-primitive.md §5.
  /// Contains: input requirements, pipeline stages + model chain,
  /// default settings, optional prompt templates, optional
  /// constraints/guardrails. Versioned via top-level `version: 1`.
  config        Json

  // ── Multi-tenant scope ──────────────────────────────────
  /// Null = global. Set = workspace-scoped (only visible to that
  /// workspace's members). Workspace-private Skills don't appear in
  /// the public marketplace.
  workspaceId   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  installations SkillInstallation[]
  /// Phase 2.5 (2026-06-10) — projects created via this Skill. Set via
  /// V2NewProjectClient picker; workers read this at submit time to
  /// resolve the active Skill config.
  originatedProjects Project[] @relation("SkillOriginatedProjects")

  @@index([authorType, status, isFeatured, popularityScore])
  @@index([slug])
  @@index([workspaceId, status])
  @@map("skills")
}

model SkillInstallation {
  id          String  @id @default(uuid())
  userId      String
  skillId     String
  /// User can toggle a Skill off without uninstalling — keeps it in
  /// "我的 Skill" list but hides it from picker dropdowns.
  enabled     Boolean @default(true)
  installedAt DateTime  @default(now())
  /// Last time the Skill was used to start a project. Drives "recently
  /// used" sort in the picker.
  lastUsedAt  DateTime?

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill  Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, enabled])
  @@map("skill_installations")
}
