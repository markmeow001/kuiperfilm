// Phase 11.3 — Props as first-class assets (knife / letter / ring / car / pet etc).
// Same shape as Locations: per-project Prop with optional reference image,
// plus a GlobalProp asset-hub variant that can be imported into a project.
// Different from characters: a prop has at most ONE primary image + a small
// gallery (via images relation, mirrors GlobalLocationImage). No appearance
// "outfit changes" because most props don't visually mutate over an episode.
model NovelPromotionProp {
  id                      String                @id @default(uuid())
  novelPromotionProjectId String
  name                    String
  summary                 String?               @db.Text // brief description (purpose / who carries it)
  // Phase 11.3 Stage A: visual prompt produced by extract_props LLM —
  // close-up of the object on neutral background, used as the image-gen
  // prompt when the user later regenerates. summary is human-facing; this
  // is what the AI reads.
  description             String?               @db.Text
  imageUrl                String?               @db.Text
  imageMediaId            String?
  imageMedia              MediaObject?          @relation("NovelPromotionPropImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  // imageHistory: JSON array of historical generated images for "undo last regen"
  imageHistory            String?               @db.Text
  // sourceGlobalPropId: when imported from /asset-hub
  sourceGlobalPropId      String?
  // Tencent VOD AIGC Element ID — see CharacterAppearance.tencentVodElementId.
  tencentVodElementId     String?               @db.VarChar(64)
  // 2026-05-22 — 火山方舟 asset API — see CharacterAppearance.arkAssetId.
  arkAssetId              String?               @db.VarChar(64)
  arkAssetStatus          String?               @db.VarChar(16)
  arkAssetSourceUrl       String?               @db.Text
  arkAssetRegisteredAt    DateTime?
  arkAssetError           String?               @db.Text
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  novelPromotionProject   NovelPromotionProject @relation(fields: [novelPromotionProjectId], references: [id], onDelete: Cascade)

  @@index([novelPromotionProjectId])
  @@index([imageMediaId])
  @@map("novel_promotion_props")
}

// Asset-hub global prop — same shape as GlobalLocation (without images junction
// for the demo MVP; if a prop needs multiple angles later we add GlobalPropImage
// like GlobalLocationImage).
model GlobalProp {
  id           String             @id @default(uuid())
  userId       String
  folderId     String?
  name         String
  summary      String?            @db.Text
  imageUrl     String?            @db.Text
  imageMediaId String?
  imageMedia   MediaObject?       @relation("GlobalPropImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  imageHistory String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation("UserGlobalProps", fields: [userId], references: [id], onDelete: Cascade)
  folder       GlobalAssetFolder? @relation("GlobalAssetFolderProps", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([imageMediaId])
  @@map("global_props")
}

// 全局音色库
model GlobalVoice {
  id                 String       @id @default(uuid())
  userId             String
  folderId           String?
  name               String // 音色名称
  description        String?      @db.Text // 详细描述
