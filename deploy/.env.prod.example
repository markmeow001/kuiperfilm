# ========================================
# kuiperAI production environment template
# ========================================
# Copy this file to `.env.prod` (NEVER commit), edit values, then run
# `./deploy.sh up`.
#
# Generate secrets in one shot:
#   ./deploy.sh init-secrets > .env.prod.secrets
# Then merge into .env.prod by hand (so you keep control of which
# values are placeholders vs intentional).
# ========================================

# --- Domain & TLS (required) ---
DOMAIN=kuiper.example.com
CADDY_EMAIL=ops@example.com

# --- Auth (required) ---
# NEXTAUTH_URL must include https:// and match DOMAIN exactly.
NEXTAUTH_URL=https://kuiper.example.com
# 64-hex string. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace_me_64_hex
# Initial admin (created by bootstrap-admin.ts on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeImmediatelyAfterFirstLogin!
# ADMIN_EMAIL=admin@example.com

# --- Internal secrets (required) ---
# 32-hex. Generate with: openssl rand -hex 16
CRON_SECRET=replace_me_32_hex
INTERNAL_TASK_TOKEN=replace_me_32_hex
# 64-hex. AES-256-GCM key. Generate with: openssl rand -hex 32
# DO NOT rotate without re-encrypting existing user_preferences API keys.
API_ENCRYPTION_KEY=replace_me_64_hex

# --- MySQL (required) ---
# Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=replace_me_strong_password
MYSQL_DATABASE=kuiper

# --- Storage ---
# Set STORAGE_TYPE=local to use a docker volume instead of R2.
STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Optional Bull Board basic-auth (recommended if you expose it via Caddy) ---
# BULL_BOARD_USER=ops
# BULL_BOARD_PASSWORD=replace_me

# --- Worker concurrency tuning (defaults shown) ---
# QUEUE_CONCURRENCY_IMAGE=50
# QUEUE_CONCURRENCY_VIDEO=50
# QUEUE_CONCURRENCY_VOICE=20
# QUEUE_CONCURRENCY_TEXT=50
# WATCHDOG_INTERVAL_MS=30000
# TASK_HEARTBEAT_TIMEOUT_MS=90000

# --- Logging ---
# LOG_LEVEL=INFO  # or DEBUG / WARN / ERROR

# --- Billing ---
# BILLING_MODE=OFF  # or PER_REQUEST when wired
